{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "node_modules/{@axelys/legal,@prisma/client,.prisma/client}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ],
  "buildCommand": null,
  "outputDirectory": null
}
